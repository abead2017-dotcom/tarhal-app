# Local development only. Copy this file to .env and fill values securely.
# Never commit .env or place server credentials in EXPO_PUBLIC_* variables.

# MySQL database used by the API and Drizzle migrations.
DATABASE_URL=

# Manus OAuth is reserved for the project administrator.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# Email/password sessions and Gmail SMTP. Required for live email authentication.
# Generate a unique random server secret of at least 32 characters.
AUTH_SECRET=
SMTP_USER=
SMTP_PASSWORD=
# Must be an authorized Gmail sender address (often the same as SMTP_USER).
SMTP_FROM=

# Local web development defaults. For a physical device, use a host-reachable API address;
# for production, use the public HTTPS API origin and matching public web origin.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_WEB_PREVIEW_URL=http://localhost:8081
# Optional for Google Maps on Android; restrict by package name and signing certificate.
GOOGLE_MAPS_API_KEY=
